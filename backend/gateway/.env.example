# ============================================================
# API Gateway — Environment Configuration
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis123@localhost:6379

# ─── JWT (must match auth-service secrets) ───────────────────
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production

# ─── Service URLs ────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
VEHICLE_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
TRACKING_SERVICE_URL=http://localhost:3006
CHAT_SERVICE_URL=http://localhost:3007
ADMIN_SERVICE_URL=http://localhost:3008
AI_SERVICE_URL=http://localhost:3009

# ─── Rate Limiting ──────────────────────────────────────────
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
PAYMENT_RATE_LIMIT=20
PAYMENT_RATE_WINDOW_SECONDS=60

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Request Limits ─────────────────────────────────────────
MAX_REQUEST_SIZE=10kb

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
