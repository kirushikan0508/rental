# ============================================================
# Payment Service — Environment Configuration
# ============================================================

NODE_ENV=development
PORT=3005

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rental_payments?schema=public"

# Redis (BullMQ queues, caching)
REDIS_URL=redis://:redis123@localhost:6379

# JWT Secret
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production

# Stripe Connect & Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayHere (Local Gateway Fallback)
PAYHERE_MERCHANT_ID=test_merchant_id
PAYHERE_SECRET=test_payhere_secret

# Commission & Platform Settings
DEFAULT_COMMISSION_PERCENT=20
CURRENCY=usd

# Subscription Plans (Stripe Price IDs)
PLAN_BASIC_ID=price_basic_15
PLAN_PRO_ID=price_pro_10
PLAN_PREMIUM_ID=price_premium_5

# Email (SMTP or SendGrid)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
EMAIL_FROM=billing@vehicle-rental.com

# CORS & Logging
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug
