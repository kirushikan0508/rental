# ============================================================
# Vehicle Service — Environment Configuration
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3003

# ─── PostgreSQL (Prisma) ────────────────────────────────────
DATABASE_URL=postgresql://admin:admin123@localhost:5432/rental_vehicles?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis123@localhost:6379

# ─── JWT (must match auth-service / gateway secret) ─────────
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production

# ─── AWS S3 ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=rental-vehicle-uploads
S3_SIGNED_URL_EXPIRY=3600

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=vehicles

# ─── Upload Limits ───────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_VEHICLE=10
MAX_DOCUMENT_SIZE_MB=10

# ─── Cache TTL (seconds) ────────────────────────────────────
VEHICLE_CACHE_TTL=600
SEARCH_CACHE_TTL=120

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
