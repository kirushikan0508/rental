# ============================================================
# Booking Service — Environment Configuration
# ============================================================

NODE_ENV=development
PORT=3004

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rental_bookings

# Redis (sessions, locks, BullMQ)
REDIS_URL=redis://:redis123@localhost:6379

# JWT (must match auth-service)
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production

# Lock Config
LOCK_TTL_SECONDS=30
LOCK_RETRY_DELAY_MS=200
LOCK_RETRY_COUNT=10

# Cancellation Policy (configurable)
CANCEL_FULL_REFUND_HOURS=48
CANCEL_PARTIAL_REFUND_HOURS=24
CANCEL_PARTIAL_REFUND_PERCENT=50

# Loyalty Points
LOYALTY_POINTS_PER_DOLLAR=1
LOYALTY_POINTS_CONVERSION_RATE=0.01

# Corporate
CORPORATE_DISCOUNT_PERCENT=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug
