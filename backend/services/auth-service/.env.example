# ============================================================
# Auth Service — Environment Configuration
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── PostgreSQL (Prisma) ────────────────────────────────────
DATABASE_URL=postgresql://admin:admin123@localhost:5432/rental_auth?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis123@localhost:6379

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── SMTP (Email) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Rental Platform <noreply@rentalplatform.com>"

# ─── OTP ─────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300

# ─── Rate Limiting ──────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
